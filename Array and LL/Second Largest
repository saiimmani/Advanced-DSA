int largest = Integer.MIN_VALUE; //   Initialize to absolute minimum i.e == - infinity 

int secondLargest = Integer.MIN_VALUE; // Initialize to absolute minimum i.e == - infinity 

for(int num : arr)
{
    if(num > largest)
    { 
        secondLargest = largest; // We have found a new highest number. Before we update largest to this new number, we take the old largest and demote it, making it the new secondLargest.
        largest = num;
    }
    else if(num > secondLargest && num != largest) // if it is  not more than largest , but greater than the second largerst then we take it as second largerst if not if it is not largest num.
    {
        secondLargest = num;
    }
}

System.out.println(secondLargest);


